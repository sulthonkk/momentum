{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://momentum-production-2caa.up.railway.app/api/:path*"
    },
    { "source": "/login", "destination": "https://momentum-production-2caa.up.railway.app/login" }
  ]
}